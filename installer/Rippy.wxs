<?xml version="1.0" encoding="UTF-8"?>
<!--
  Per-user MSI for Rippy (WiX v5). Installs to %LOCALAPPDATA%\Programs\Rippy, so it needs no admin rights, which
  also lets the in-app "Install update" button run the next MSI without a UAC prompt.
  Built by .github/workflows/build.yml:
    wix build installer\Rippy.wxs -arch x64 -d Version=<x.y.z> -d ExePath=<rip.exe> -d IconPath=<rippy.ico> -d FlagPath=<installed.flag> -o Rippy.msi
  The UpgradeCode must NEVER change: it is how a newer MSI finds and replaces an older install.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Rippy" Manufacturer="Rippy" Version="$(Version)"
           UpgradeCode="7D2926A5-CA91-4B3C-BABE-12D3B5162D6B" Scope="perUser" Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Rippy is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="rippy.ico" SourceFile="$(IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="rippy.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MegaTheLEGEND/Auto-DVD-Ripper" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Rippy" />
      </Directory>
    </StandardDirectory>

    <Component Id="RippyApp" Directory="INSTALLFOLDER" Guid="FEE779F3-C1B6-4934-98E5-63DA3DEB8083">
      <File Id="RippyExe" Source="$(ExePath)" Name="Rippy.exe" />
      <!-- installed.flag next to the exe tells the app it was installed from this MSI (see is_installed() in rip.py) -->
      <File Id="InstalledFlag" Source="$(FlagPath)" Name="installed.flag" />
      <!-- per-user components need a HKCU key path; with files in it the component needs a fixed Guid (not "*"), which must never change -->
      <RegistryValue Root="HKCU" Key="Software\Rippy" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      <!-- the app reads this to offer Settings > About > Uninstall -->
      <RegistryValue Root="HKCU" Key="Software\Rippy" Name="ProductCode" Type="string" Value="[ProductCode]" />
      <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      <RemoveFolder Id="RemoveProgramsFolder" Directory="LocalProgramsDir" On="uninstall" />
      <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Rippy"
                Description="Auto DVD / Blu-ray ripper" Target="[#RippyExe]"
                WorkingDirectory="INSTALLFOLDER" Icon="rippy.ico" />
      <Shortcut Id="UninstallShortcut" Directory="ProgramMenuFolder" Name="Uninstall Rippy"
                Description="Remove Rippy from this PC" Target="[SystemFolder]msiexec.exe"
                Arguments="/x [ProductCode]" Icon="rippy.ico" />
    </Component>

    <!-- After a first install, start Rippy; it then says it is installed (it is started with the just-installed switch). In-app updates and silent
         installs pass NOLAUNCH=1 so nothing opens (the update restarts Rippy itself). -->
    <CustomAction Id="LaunchRippy" FileRef="RippyExe" ExeCommand="--just-installed" Execute="immediate"
                  Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchRippy" After="InstallFinalize" Condition="NOT Installed AND NOT NOLAUNCH" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Rippy" Level="1">
      <ComponentRef Id="RippyApp" />
    </Feature>
  </Package>
</Wix>
